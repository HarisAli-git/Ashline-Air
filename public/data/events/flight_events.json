    "tags": [
      "weather"
    ],
    "choices": [
      {
        "id": "increase_throttle",
        "label": "Firewall it and hold the schedule",
        "consequences": [
          {
            "type": "action",
            "target": "full_power",
            "value": 0.35,
            "description": "Throttle up"
          },
          {
            "type": "multiply",
            "target": "fuelBurnRate",
            "value": 1.4,
            "description": "Burn up 40%"
          },
          {
            "type": "delta",
            "target": "engineTemp",
            "value": 0.1,
