          },
          {
            "type": "add_money",
            "target": "player",
            "value": 500,
            "description": "The survivors pay what they have"
          }
        ]
      },
      {
        "id": "ignore",
        "label": "Log the position and keep going",
        "consequences": [
          {
            "type": "add_reputation",
