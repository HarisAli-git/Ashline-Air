    "cooldownSeconds": 600,
    "tags": [
      "weather",
      "navigation"
    ],
    "choices": [
      {
        "id": "fly_through",
        "label": "Bore straight through it",
        "consequences": [
          {
            "type": "delta",
            "target": "integrity",
            "value": -15,
            "description": "Grit scours the airframe"
          },
          {
            "type": "multiply",
            "target": "fuelBurnRate",
            "value": 1.2,
            "description": "Headwind drives the burn up"
          }
        ]
      },
      {
        "id": "climb_over",
        "label": "Climb over the top",
        "consequences": [
          {
            "type": "delta",
            "target": "fuel",
            "value": -10,
