            "target": "altitude",
            "value": 320,
            "description": "Up and over"
          },
          {
            "type": "action",
            "target": "clear_weather",
            "value": 0,
            "description": "Clear air above the storm"
          }
        ]
      },
      {
        "id": "go_around",
        "label": "Track around the edge of it",
        "consequences": [
          {
            "type": "delta",
            "target": "fuel",
            "value": -15,
            "description": "The long way costs fuel"
          },
          {
            "type": "action",
            "target": "extend_route",
            "value": 0.8,
            "description": "0.8 km added to the leg"
          },
          {
            "type": "action",
            "target": "clear_weather",
            "value": 0,
            "description": "You skirt the worst of it"
          }
        ]
      }
    ]
  },
  {
    "id": "distress_signal",
    "title": "Distress Signal",
    "description": "Your radio crackles with a weak distress call. Someone is stranded not far from your current position.",
    "trigger": "random",
    "probability": 0.014,
    "cooldownSeconds": 900,
    "tags": [
      "random",
      "reputation"
    ],
    "choices": [
      {
        "id": "investigate",
        "label": "Divert, find them, then carry on",
        "consequences": [
          {
            "type": "delta",
            "target": "fuel",
            "value": -12,
            "description": "The detour costs fuel"
          },
          {
            "type": "action",
            "target": "extend_route",
            "value": 0.6,
            "description": "0.6 km added to the leg"
          },
          {
            "type": "add_reputation",
